{
  "name": "claude-session-manager",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "description": "Claude Code session manager desktop app",
  "author": "modec28",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/modec28/claude-session-manager.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "bash -c 'pnpm exec tsc --noEmit'",
    "src-tauri/src/**/*.rs": [
      "bash -c 'cd src-tauri && cargo fmt --check'",
      "bash -c 'cd src-tauri && cargo clippy --quiet -- -D warnings'",
      "bash -c 'cd src-tauri && cargo test --quiet'"
    ]
  }
}
